# === Signa Cafe — Apache config ===

# 1. Защита служебных файлов и секретов
<FilesMatch "^\.(htaccess|htpasswd|env|gitignore|gitattributes|openai_key|admin-auth\.php|admin-throttle\.json)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.git
RedirectMatch 404 /CHANGES\.md$
RedirectMatch 404 /CLAUDE_BRIEF\.md$
RedirectMatch 404 /CLAUDE\.md$
RedirectMatch 404 /README\.md$

# 2. Доступ в админку
#
# Basic Auth сняли 05.09.2026: браузерный диалог не показывался ни в Arc, ни во
# встроенном браузере Claude - обе программы рисовали апачевскую страницу 401,
# а ввести пароль было негде. Теперь вход - PHP-сессия (lib/auth.php), и каждый
# защищённый .php проверяет её сам. Здесь остаётся только то, что PHP проверить
# не может: статические файлы, которые наружу отдавать нельзя вообще.
#
# admin.jsx и два JSON с расходами читает с диска admin.php после проверки
# сессии (admin.php?asset=jsx|costs|pricing), поэтому по HTTP они закрыты.
<Files "admin.jsx">
  Require all denied
</Files>
<FilesMatch "^(story-costs|model-pricing)\.json$">
  Require all denied
</FilesMatch>

# Общие подключаемые файлы: нужны только через require() из PHP, по HTTP - нет.
RedirectMatch 404 ^/lib/

# Block direct access to raw analytics JSONL logs (admin reads them through analytics.php)
RedirectMatch 404 /analytics/.*$

# 3. Cache control — immutable assets cached long, code/HTML must revalidate
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
</IfModule>

# Code & data files — always revalidate so deploys reach users immediately.
# Browsers store a copy but check freshness with If-Modified-Since on every request.
<FilesMatch "\.(jsx|html|json)$">
  Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>

# 4. JSX as JavaScript (для Babel transpile)
AddType application/javascript .jsx
AddType model/obj .obj
AddType model/mtl .mtl

# 5. Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# 6. Pretty URLs + server-rendered Stories
#
# WHY: index/menu/about/visit are React transpiled in the browser. Googlebot runs
# JS and copes, but AI crawlers (GPTBot, ClaudeBot, PerplexityBot, CCBot) do not —
# they see an empty <div id="root">. The Stories section is therefore rendered
# server-side by PHP so every word is in the raw HTML on first byte.
# sitemap.xml / feed.xml / llms.txt are generated too, so a new post in
# data/stories.json appears everywhere with no build step and no manual edit.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^admin/?$     admin.php [L,QSA]
  RewriteRule ^admin\.html$ admin.php [L,QSA]

  # Order matters: the /ru variants must be tested before the generic slug rule.
  # Order matters: the language variants must be tested before the generic
  # slug rule, or /stories/ru would be read as a post called "ru".
  RewriteRule ^stories/?$                        stories.php                     [L]
  RewriteRule ^stories/(ru|id)/?$                stories.php?lang=$1             [L]
  RewriteRule ^stories/(ru|id)/([a-z0-9-]+)/?$   story.php?slug=$2&lang=$1       [L]
  RewriteRule ^stories/([a-z0-9-]+)/?$           story.php?slug=$1               [L]

  RewriteRule ^feed\.xml$    feed.php     [L,QSA]
  RewriteRule ^sitemap\.xml$ sitemap.php  [L]
  RewriteRule ^llms\.txt$    llms.php     [L]
</IfModule>

# 7. Story source data: readable (it is public content anyway) but kept out of
#    the index so it cannot compete with the rendered pages.
<Files "stories.json">
  <IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex"
  </IfModule>
</Files>

# 8. No directory listings anywhere.
Options -Indexes

# 9. Cost ledger and rate card: the admin Costs tab reads them, nobody else.
#    Unlike stories.json these are not public content - they hold what the
#    generation actually cost and what the work is billed at. Same realm as
#    admin.html, so the browser already has the credentials by the time the
#    tab fetches them.
# (защита story-costs/model-pricing.json переехала в секцию 2)
