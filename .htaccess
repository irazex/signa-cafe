# === Signa Cafe — Apache config ===

# 1. Защита служебных файлов
<FilesMatch "^\.(htaccess|htpasswd|env|gitignore|gitattributes)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.git
RedirectMatch 404 /CHANGES\.md$
RedirectMatch 404 /CLAUDE_BRIEF\.md$
RedirectMatch 404 /CLAUDE\.md$
RedirectMatch 404 /README\.md$

# 2. Basic Auth для admin
<Files "admin.html">
  AuthType Basic
  AuthName "Signa Admin"
  AuthUserFile /home/aqq17894/.htpasswd
  Require valid-user
</Files>
<Files "admin.jsx">
  AuthType Basic
  AuthName "Signa Admin"
  AuthUserFile /home/aqq17894/.htpasswd
  Require valid-user
</Files>

# 3. Cache control — immutable assets cached long, code/HTML must revalidate
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
</IfModule>

# Code & data files — always revalidate so deploys reach users immediately.
# Browsers store a copy but check freshness with If-Modified-Since on every request.
<FilesMatch "\.(jsx|html|json)$">
  Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>

# 4. JSX as JavaScript (для Babel transpile)
AddType application/javascript .jsx
AddType model/obj .obj
AddType model/mtl .mtl

# 5. Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# 6. Pretty URLs — /admin → /admin.html (so Basic Auth still triggers)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^admin/?$ admin.html [L]
</IfModule>
